---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/VrsnsPost.astro';

export async function getStaticPaths() {
	const posts = await getCollection('vrsns');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'vrsns'>;

const post = Astro.props;
const { Content, headings } = await render(post);
---

<BlogPost {...post.data} headings={headings} ogImagePath={`/og/vrsns/${post.id}.png`}>
	<Content />
</BlogPost>
