---
import { Image } from 'astro:assets';
import ZokasuFullbody from '../assets/ZokasuFullbody.webp';
import ExploreHub from '../components/ExploreHub.astro';
import {
	ABOUT_DESCRIPTION,
	ACTIVITY_FIELDS,
	CHRONOLOGY,
	INTRO_PARAGRAPHS,
	LAB_WORKS,
	OSS_GROUPS,
	RESONITE_ACTIVITIES,
	SUBTITLES,
	TOOLS,
} from '../data/profile';
import Page from '../layouts/Page.astro';

const exploreInternal = [
	{ label: 'トップページ', href: '/', note: 'いまの活動と代表作のまとめ' },
	{ label: 'VRSNSの記事', href: '/vrsns/', note: 'Resonite・VRChatの技術記事' },
	{ label: 'ブログ', href: '/blog/', note: 'サイトや日々のこと' },
];
---

<Page title="プロフィール" description={ABOUT_DESCRIPTION} ogImagePath="/og/about.png">
	<div class="profile">
		<section class="intro">
			<div class="intro-copy">
				<h1>プロフィール</h1>
				<ul class="subtitles">
					{SUBTITLES.map((subtitle) => <li>{subtitle}</li>)}
				</ul>
				{INTRO_PARAGRAPHS.map((paragraph) => <p>{paragraph}</p>)}
			</div>
			<Image
				src={ZokasuFullbody}
				alt="ぞぞかすのアバターの全身イラスト"
				width={280}
				class="intro-image"
			/>
		</section>

		<section class="block">
			<h2>活動分野</h2>
			{
				ACTIVITY_FIELDS.map((field) => (
					<div class="field" id={field.id}>
						<h3>{field.heading}</h3>
						<ul>
							{field.items.map((item) => (
								<li>{item}</li>
							))}
						</ul>
					</div>
				))
			}
		</section>

		<section class="block">
			<h2>Resoniteでの主な活動</h2>
			{
				RESONITE_ACTIVITIES.map((activity) => (
					<div class="entry">
						<h3>{activity.title}</h3>
						<p>{activity.body}</p>
						{activity.links.length > 0 && (
							<ul class="entry-links">
								{activity.links.map((link) => (
									<li>
										<a href={link.href} target="_blank" rel="noopener noreferrer">
											{link.label}
											<span aria-hidden="true">↗</span>
											<span class="sr-only">（外部サイト・新しいタブで開きます）</span>
										</a>
									</li>
								))}
							</ul>
						)}
					</div>
				))
			}
		</section>

		<section class="block" id="lab">
			<h2>かっすり研究所（VRChat向け）</h2>
			{
				LAB_WORKS.map((work) => (
					<div class="entry">
						<h3>{work.title}</h3>
						<p>{work.body}</p>
						{work.links.length > 0 && (
							<ul class="entry-links">
								{work.links.map((link) => (
									<li>
										<a href={link.href} target="_blank" rel="noopener noreferrer">
											{link.label}
											<span aria-hidden="true">↗</span>
											<span class="sr-only">（外部サイト・新しいタブで開きます）</span>
										</a>
									</li>
								))}
							</ul>
						)}
					</div>
				))
			}
		</section>

		<section class="block" id="web">
			<h2>Web・OSS</h2>
			{
				OSS_GROUPS.map((group) => (
					<div class="entry">
						<h3>{group.heading}</h3>
						<ul class="entry-links">
							{group.links.map((link) => (
								<li>
									<a href={link.href} target="_blank" rel="noopener noreferrer">
										{link.label}
										<span aria-hidden="true">↗</span>
										<span class="sr-only">（外部サイト・新しいタブで開きます）</span>
									</a>
								</li>
							))}
						</ul>
						<p class="note">{group.note}</p>
					</div>
				))
			}
		</section>

		<section class="block">
			<h2>略歴</h2>
			<table>
				<thead>
					<tr>
						<th scope="col">時期</th>
						<th scope="col">内容</th>
					</tr>
				</thead>
				<tbody>
					{
						CHRONOLOGY.map((entry) => (
							<tr>
								<th scope="row">{entry.year}</th>
								<td>{entry.body}</td>
							</tr>
						))
					}
				</tbody>
			</table>
		</section>

		<section class="block" id="tools">
			<h2>技術・道具</h2>
			<dl class="tools">
				{
					TOOLS.map((tool) => (
						<div class="tool">
							<dt>{tool.name}</dt>
							<dd>{tool.usage}</dd>
						</div>
					))
				}
			</dl>
		</section>

		<ExploreHub
			title="連絡先・ほかの行き先"
			lead="連絡はXかMisskeyが届きやすいです。制作物は下の場所に置いています。"
			internal={exploreInternal}
		/>
	</div>
</Page>

<style>
	.profile {
		--accent-teal: #0a6e70;
	}

	.intro {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 2rem;
		align-items: start;
	}

	.intro h1 {
		margin-bottom: 0.6rem;
		font-size: clamp(2rem, 5vw, 2.5rem);
	}

	.subtitles {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0 0 1.2rem;
		padding: 0;
		list-style: none;
	}

	.subtitles li {
		padding: 0.15rem 0.7rem;
		border-radius: 999px;
		background: rgba(10, 110, 112, 8%);
		color: var(--accent-teal);
		font-size: 0.8rem;
		font-weight: 700;
	}

	.intro-copy p {
		font-size: 0.95rem;
		line-height: 1.85;
	}

	.intro-image {
		width: min(240px, 32vw);
		height: auto;
	}

	.block {
		padding-top: 2.75rem;
		scroll-margin-top: 1.5rem;
	}

	.block h2 {
		font-size: 1.953em;
	}

	.field,
	.entry {
		padding-top: 1.25rem;
		scroll-margin-top: 1.5rem;
	}

	.field h3,
	.entry h3 {
		font-size: 1.25em;
	}

	.field ul {
		margin: 0;
		padding-left: 1.2em;
	}

	.field li,
	.entry p {
		font-size: 0.95rem;
		line-height: 1.85;
	}

	.entry p {
		margin-bottom: 0.5rem;
	}

	.entry-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1.1rem;
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: 0.9rem;
	}

	.note {
		margin-top: 0.6rem;
		color: rgb(var(--gray));
		font-size: 0.85rem;
		line-height: 1.75;
	}

	table {
		border-collapse: collapse;
		font-size: 0.95rem;
	}

	th,
	td {
		padding: 0.6rem 0.8rem 0.6rem 0;
		border-bottom: 1px solid rgb(var(--gray-light));
		text-align: left;
		vertical-align: top;
	}

	tbody th {
		width: 5em;
		color: var(--accent-teal);
		font-variant-numeric: tabular-nums;
	}

	.tools {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 1rem;
		margin: 0;
	}

	.tool {
		padding: 0.9rem 1rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 8px;
	}

	.tool dt {
		font-weight: 700;
	}

	.tool dd {
		margin: 0.2rem 0 0;
		color: rgb(var(--gray));
		font-size: 0.85rem;
		line-height: 1.7;
	}

	a:focus-visible {
		outline: 3px solid var(--accent-teal);
		outline-offset: 3px;
	}

	@media (max-width: 720px) {
		.intro {
			grid-template-columns: minmax(0, 1fr);
			gap: 1.25rem;
			justify-items: start;
		}

		.intro-image {
			width: 180px;
			order: -1;
		}

		.block {
			padding-top: 2.25rem;
		}
	}
</style>
