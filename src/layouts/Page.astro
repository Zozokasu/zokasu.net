---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

interface Props {
	title: string;
	description: string;
	ogImagePath?: string;
	wide?: boolean;
}

const { title, description, ogImagePath, wide = false } = Astro.props;
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={title} description={description} ogImagePath={ogImagePath} />
	</head>
	<body>
		<Header />
		<main class:list={[{ wide }]}>
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style>
	main.wide {
		width: min(1080px, 100% - 2em);
		max-width: none;
	}
</style>
