---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import TableOfContents from '../components/TableOfContents.astro';

type Props = CollectionEntry<'vrsns'>['data'] & {
	headings?: {
		depth: number;
		slug: string;
		text: string;
	}[];
	ogImagePath?: string;
};

const { title, description, pubDate, updatedDate, heroImage, headings = [], ogImagePath } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={heroImage} ogImagePath={ogImagePath} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
				text-autospace: normal;
				line-break: strict;
				font-family: "BIZ UDPGothic";
			}
			.post-shell {
				box-sizing: border-box;
				display: grid;
				grid-template-columns: minmax(0, 1fr) minmax(0, 720px) minmax(220px, 260px);
				gap: 2rem;
				width: min(100%, 1180px);
				margin: 0 auto;
				padding: 0 1em;
				align-items: start;
			}
			.post-shell .prose {
				box-sizing: border-box;
				grid-column: 2;
				width: 100%;
				max-width: 100%;
				margin: 0;
				padding: 1em 0;
			}
			.post-shell :global(.toc) {
				grid-column: 3;
				margin-top: 1em;
			}
			.title {
				margin: 0 calc(50% - 50vw);
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				font-size: 2.369rem;
				margin: 0 0 0.5em 0;
				font-family:'Noto Sans JP', sans-serif;
			}
			.date {
				font-family:'Noto Sans JP', sans-serif;
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}
			@media (max-width: 1080px) {
				.post-shell {
					display: block;
					width: 720px;
					max-width: calc(100% - 2em);
					padding: 0;
				}
				.post-shell .prose {
					width: 100%;
					max-width: 100%;
					margin: auto;
					padding: 1em;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="post-shell">
					<div class="prose">
						<div class="title">
							<div class="date">
								<FormattedDate date={pubDate} />
								{
									updatedDate && (
										<div class="last-updated-on">
											Last updated on <FormattedDate date={updatedDate} />
										</div>
									)
								}
							</div>
							<h1>{title}</h1>
							<hr />
						</div>
						<slot />
					</div>
					<TableOfContents headings={headings} variant="vrsns" />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
